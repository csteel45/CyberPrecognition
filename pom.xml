  		<version>0.1.7</version>
  		<scope>system</scope>
  		<systemPath>${basedir}/lib/javaml-0.1.7.jar</systemPath>
	</dependency>
   	<dependency>
  		<groupId>net.ripe.hadoop.pcap</groupId>
  		<artifactId>hadoop-pcap-lib</artifactId>
  		<version>1.1</version>
  		<scope>system</scope>
  		<systemPath>${basedir}/lib/hadoop-pcap-lib-1.1-SNAPSHOT.jar</systemPath>
	</dependency>
	<dependency>
